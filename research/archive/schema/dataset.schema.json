{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nlgcp.local/schemas/archive/dataset.schema.json",
  "title": "NLGCP Research Archive Dataset Manifest (v1)",
  "type": "object",
  "required": [
    "schema_version",
    "dataset_id",
    "name",
    "dataset_type",
    "source_classification",
    "source_provider",
    "description",
    "acquisition_method",
    "immutable_source",
    "storage",
    "integrity",
    "metadata",
    "licensing",
    "registration",
    "relationships"
  ],
  "properties": {
    "schema_version": { "const": "nlgcp.archive.dataset.v1" },
    "dataset_id": { "type": "string", "pattern": "^NLGCP-DATA-\\d{4}-\\d{3}$" },
    "name": { "type": "string", "minLength": 1 },
    "dataset_type": { "type": "string", "minLength": 1 },
    "source_classification": {
      "enum": [
        "AUTHENTIC_LIVE_CORS",
        "AUTHENTIC_RECORDED_CORS",
        "THIRD_PARTY_CORRECTION_STREAM",
        "SYNTHETIC_TEST_DATA",
        "SIMULATED_DATA",
        "MODELLED_DATA",
        "DERIVED_DATA",
        "UNKNOWN"
      ]
    },
    "source_provider": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "acquisition_method": { "type": "string", "minLength": 1 },
    "immutable_source": { "type": "boolean" },
    "storage": {
      "type": "object",
      "required": ["location", "storage_type", "original_filename"],
      "properties": {
        "location": { "type": "string", "minLength": 1 },
        "storage_type": { "enum": ["REPOSITORY", "EXTERNAL_FILESYSTEM", "UNAVAILABLE"] },
        "original_filename": { "type": "string", "minLength": 1 },
        "file_size_bytes": { "type": ["integer", "null"] }
      }
    },
    "integrity": {
      "type": "object",
      "required": ["algorithm", "expected_hash", "verification_status"],
      "properties": {
        "algorithm": { "const": "SHA256" },
        "expected_hash": { "type": "string", "minLength": 1 },
        "verification_status": { "type": "string", "minLength": 1 }
      }
    },
    "metadata": {
      "type": "object",
      "required": [
        "format",
        "temporal_coverage",
        "station_count",
        "constellations",
        "sampling_interval_s",
        "coordinate_reference_status",
        "reference_frame"
      ]
    },
    "licensing": { "type": "object" },
    "registration": { "type": "object" },
    "relationships": { "type": "object" }
  }
}
