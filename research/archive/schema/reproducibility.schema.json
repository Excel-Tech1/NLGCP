{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nlgcp.local/schemas/archive/reproducibility.schema.json",
  "title": "NLGCP Research Archive Reproducibility Attempt Records (v1)",
  "type": "object",
  "required": ["schema_version", "reproductions"],
  "properties": {
    "schema_version": { "const": "nlgcp.archive.reproducibility.v1" },
    "reproductions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "reproduction_id",
          "original_experiment_id",
          "input_dataset_ids",
          "input_hashes",
          "software_versions",
          "source_commit",
          "configuration",
          "execution_command",
          "environment",
          "expected_output",
          "actual_output",
          "output_hash",
          "metric_comparison",
          "differences",
          "outcome",
          "reproduction_level"
        ]
      }
    }
  }
}
