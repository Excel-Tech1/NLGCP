{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API: FastAPI",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["nlgcp_api.main:app", "--reload"],
      "env": {"PYTHONPATH": "${workspaceFolder}/apps/api/src"}
    },
    {
      "name": "Go: GNSS Ingestor",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/services/gnss-ingestor/cmd/ingestor"
    }
  ]
}
