# Phase 12 Local Loopback-Only NTRIP Lab Caster Example Configuration
#
# SECURITY WARNING:
# - Bind ONLY to 127.0.0.1. Non-loopback bindings are rejected by config.py.
# - Replace CHANGE_ME placeholders locally; NEVER commit real credentials or .env.
# - HTTP Basic auth is NOT suitable for untrusted networks without TLS.
# - Output is SYNTHETIC TEST DATA — NOT VALID FOR NAVIGATION OR SCIENTIFIC POSITIONING RESULTS.

NLGCP_CASTER_HOST=127.0.0.1
NLGCP_CASTER_PORT=2101
NLGCP_CASTER_MOUNTPOINT=NLGCP_TEST
NLGCP_CASTER_CLIENT_USER=lab_client
NLGCP_CASTER_CLIENT_PASSWORD=CHANGE_ME
NLGCP_CASTER_SOURCE_USER=lab_source
NLGCP_CASTER_SOURCE_PASSWORD=CHANGE_ME
